{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin/login",
      "destination": "/admin-login"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/",
      "destination": "/"
    },
    {
      "source": "/clients",
      "destination": "/index.html#clients"
    },
    {
      "source": "/reports",
      "destination": "/index.html#reports"
    },
    {
      "source": "/calendar",
      "destination": "/index.html#calendar"
    }
  ],
  "crons": [
    {
      "path": "/api/backup",
      "schedule": "40 15 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "40 16 * * *"
    },
    {
      "path": "/api/daily-report-rollup",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/daily-report-rollup",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/bank-reconcile",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-dc+tNCcBKyY9AilOXQc5OKV7iFPNHd4e6eqjc1sBPlw=' 'sha256-hUPOgJMtLFx7gW8juCuiHHpp4jPaY5pbZTtjK+NALBk=' 'sha256-NR+CVkO+g0xRtqQOOr+rZnXsgWp64KgEruQrCuHpTNU='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; media-src 'self' data: blob:; worker-src 'self'; frame-src 'self' data: blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/marketizo-sign(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/sign(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "regions": [
    "dub1"
  ],
  "buildCommand": "pnpm test && node scripts/build-static.cjs",
  "installCommand": "pnpm install --frozen-lockfile --prod=false",
  "outputDirectory": "public",
  "functions": {
    "api/finance-payment-actions.js": {
      "maxDuration": 60
    },
    "api/bank-reconcile.js": {
      "maxDuration": 60
    },
    "api/finance-source-sync.js": {
      "maxDuration": 60
    },
    "api/finance-monthly-documents.js": {
      "maxDuration": 60
    }
  }
}
