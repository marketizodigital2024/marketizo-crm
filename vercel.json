{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin/login", "destination": "/admin-login" },
    { "source": "/admin", "destination": "/" },
    { "source": "/admin/", "destination": "/" },
    { "source": "/clients", "destination": "/index.html#clients" },
    { "source": "/reports", "destination": "/index.html#reports" },
    { "source": "/calendar", "destination": "/index.html#calendar" }
  ],
  "crons": [
    { "path": "/api/backup", "schedule": "15 1 * * *" }
  ]
}
